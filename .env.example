APP_ENV=development
HOST=127.0.0.1
PORT=4317
APP_ORIGIN=http://127.0.0.1:4317

# MySQL 8+. URL-encode special characters in the user name and password.
DATABASE_URL=
# An isolated application schema; overrides the database path in DATABASE_URL.
DATABASE_SCHEMA=FutureTool
# Remote databases use verified TLS by default. Set a CA path if required.
MYSQL_TLS=required
MYSQL_CA_FILE=
MYSQL_CONNECTION_LIMIT=4

# Google OAuth web application. Register APP_ORIGIN/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 cryptographically random bytes locally; see the PowerShell command in README.
SESSION_SECRET=

# Transparent initial-beta capacity limits, not paid tiers.
MAX_USERS=200
MAX_PROBLEMS=500
MAX_PROBLEMS_PER_USER=10
MAX_SAVED_ATTEMPTS=20
PROVIDER_CONCURRENCY=8

# External tools are disabled by default. No candidate code runs on this host.
# Judge0 CE uses each student's separately consented RapidAPI key.
EXECUTION_ENABLED=false

# Optional support checkout only; practice stays free.
# Enable only after approving an amount, configuring the merchant account,
# and verifying test-mode checkout plus signed webhooks on a public HTTPS host.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SUPPORT_AMOUNT_PAISE=0
